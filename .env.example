# Copy to .env and fill in. Never commit .env.
PORT=8787
NODE_ENV=development

# Signs login cookies. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Silvy, the pricing assistant, runs in agent-service (Gemini). Leave both blank
# to run without it. SILVY_SHARED_SECRET must equal the agent-service value
# (openssl rand -hex 32); SILVY_URL is the agent base URL, e.g. http://localhost:8888.
SILVY_URL=
SILVY_SHARED_SECRET=
# Set to true when the agent is a private Cloud Run service: the app then sends a Google
# ID token minted with GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY.
SILVY_IAM_AUTH=
# Hard caps on Silvy questions + documents (WIB calendar periods). Defaults: 3000 / month, 150 / user / day.
# Each accepted forwarding attempt counts, including errors/timeouts, since it may incur model usage.
SILVY_MONTHLY_LIMIT=
SILVY_USER_DAILY_LIMIT=

# Gemini key for reading PDF/photo request lists (list -> quote). Leave blank to
# keep the feature off (the endpoint answers 503). Use a paid-tier key: client
# documents are sent to Google. Model defaults to gemini-3.5-flash (stable).
GEMINI_API_KEY=
GEMINI_MODEL=

# Seed administrator (created once on first run)
ADMIN_EMAIL=admin@salvator.co.id
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# SQLite location
DATABASE_PATH=./data/halokantor.db

# Base URL the notification emails/WhatsApp messages link back to.
APP_URL=http://localhost:5173

# Approval-workflow notifications (submit -> notify managers, decide ->
# notify the submitting rep). Leave either group blank to run without that
# channel — both are optional and independent of each other.

# Email via the Gmail API, sent as a real Google Workspace mailbox using a
# service account with domain-wide delegation (no per-user OAuth prompts).
# Setup (one-time, in Google Cloud Console + Workspace admin):
#   1. Create/select a GCP project, enable the Gmail API.
#   2. Create a service account, generate a JSON key.
#   3. In Workspace Admin > Security > API controls > Domain-wide delegation,
#      authorize the service account's Client ID for scope:
#      https://www.googleapis.com/auth/gmail.send
#   4. GOOGLE_SERVICE_ACCOUNT_EMAIL is the JSON key's "client_email".
#   5. GOOGLE_PRIVATE_KEY is the JSON key's "private_key" (keep the \n escapes
#      as-is when pasting into this file; they're unescaped at runtime).
#   6. GOOGLE_SEND_AS_EMAIL is a real Workspace mailbox to send as
#      (e.g. noreply@salvator.co.id) — the service account impersonates it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SEND_AS_EMAIL=

# WhatsApp via Twilio (https://www.twilio.com/whatsapp). TWILIO_WHATSAPP_FROM
# is your Twilio WhatsApp-enabled number, e.g. +14155238886 for the sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
