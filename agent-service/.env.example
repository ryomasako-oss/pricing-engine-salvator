# Pricing Engine Salvator Agent — env template
# Salin ke .env dan isi nilainya.

# API halokantor (read-only akses ke pricing.salvator.co.id)
HALOKANTOR_API_BASE=https://pricing.salvator.co.id
HALOKANTOR_API_KEY=

# Gemini (Google AI Studio, tier berbayar) — satu-satunya LLM Silvy
GEMINI_API_KEY=
# Opsional; default gemini-3.1-flash-lite
GEMINI_MODEL=

# SQLite knowledge store (lokasi file, relatif ke working dir)
AGENT_DB_PATH=./data/agent-knowledge.db

# Gmail / Google Workspace (optional — untuk email trigger)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SEND_AS_EMAIL=

# Server (optional — jika agent dijalanin sebagai HTTP service)
AGENT_PORT=8888

# Silvy: rahasia bersama dengan aplikasi pricing (header x-silvy-secret). Kosong = Silvy mati.
SILVY_SHARED_SECRET=
