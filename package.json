{
  "name": "pricing-engine-salvator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Halokantor B2B Pricing & Quotation Engine - PT Salvator Inti Pratama",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "wrangler dev --local --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/test-approval-workflow.ts",
    "test:scenarios": "tsx scripts/test-api-scenarios.ts",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.worker-tests.json",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed:local": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
